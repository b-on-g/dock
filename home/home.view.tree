$bog_dock_home $mol_view
	title @ \Bog Dock
	bar $bog_dock_bar
	focus? -1
	sub /
		<= Head $mol_view
			dom_name \h1
			sub /
				<= Head_own $mol_view
					sub /
						\Bog
				<= Head_accent $mol_view
					sub /
						\Dock
		<= Stage $mol_view
			sub <= stage /$mol_view
				<= Lines $mol_svg_root
					view_box \0 0 100 100
					sub <= lines /$mol_view
						<= Orbit $mol_svg_circle
							radius <= orbit \38
							pos /
								50
								50
				^ nodes /$mol_view
					<= Node*0 $bog_dock_home_node
						title <= node_title* \
						uri <= node_uri* \
						icon <= node_icon* \
						place <= node_place* /number
						main <= node_main* false
						dim <= node_dim* false
						hover? <=> node_hover*? null
						leave? <=> node_leave? null
		<= Caption $mol_view
			sub /
				<= caption @ \Hover an app to see its connections
	Line*0 $mol_svg_path
		geometry <= line_geometry* \
		attr *
			^
			bog_dock_home_kind <= line_kind* \
			bog_dock_home_dim <= line_dim* false
	label_login @ \Sign in with ID
	label_embed @ \Built in
	label_none @ \No connections yet
