$mol_theme_auto $mol_plugin
	light \$mol_theme_light
	attr * mol_theme <= theme <= dark \$mol_theme_dark

$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$mol_link $mol_view
	uri \
	dom_name \a
	uri_off \
	uri_native null
	external false
	attr *
		^
		href <= uri_unsafe <= uri_toggle \
		title <= hint_safe <= hint \
		target <= target \_self
		download <= file_name \
		mol_link_current <= current false
		rel <= relation \
	sub /$mol_view_content
		<= title
	arg *
	event *
		^
		click? <=> click? <=> event_click? null

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16

$giper_web_bar_link $mol_link
	target \_parent
	uri_toggle <= uri
	sub /
		<= Icon $mol_image
			uri <= icon \
			hint <= title
		<= Title $mol_view sub / <= title

$mol_svg $mol_view
	dom_name \svg
	dom_name_space \http://www.w3.org/2000/svg
	font_size 16
	font_family \
	style_size *

$mol_svg_root $mol_svg
	dom_name \svg
	attr *
		^
		viewBox <= view_box \0 0 100 100
		preserveAspectRatio <= aspect \xMidYMid

$mol_svg_path $mol_svg
	dom_name \path
	attr *
		^
		d <= geometry \


$mol_icon $mol_svg_root
	view_box \0 0 24 24
	minimal_width 16
	minimal_height 16
	sub /
		<= Path $mol_svg_path
			geometry <= path \

$mol_icon_script $mol_icon path \M17.8,20C17.4,21.2 16.3,22 15,22H5C3.3,22 2,20.7 2,19V18H5L14.2,18C14.6,19.2 15.7,20 17,20H17.8M19,2H8C6.3,2 5,3.3 5,5V16H16V17C16,17.6 16.4,18 17,18H18V5C18,4.4 18.4,4 19,4C19.6,4 20,4.4 20,5V6H22V5C22,3.3 20.7,2 19,2Z

$mol_icon_script_text $mol_icon path \M17.8,20C17.4,21.2 16.3,22 15,22H5C3.3,22 2,20.7 2,19V18H5L14.2,18C14.6,19.2 15.7,20 17,20H17.8M19,2C20.7,2 22,3.3 22,5V6H20V5C20,4.4 19.6,4 19,4C18.4,4 18,4.4 18,5V18H17C16.4,18 16,17.6 16,17V16H5V5C5,3.3 6.3,2 8,2H19M8,6V8H15V6H8M8,10V12H14V10H8Z

$mol_link_source $mol_link
	hint @ \Source code
	sub /
		<= Icon $mol_icon_script_text

$giper_web_bar $mol_page
	plugins /
		<= Theme $mol_theme_auto
	head /
		<= Giper $giper_web_bar_link
			title <= title @ \Giper Web
			uri \https://web.giper.dev/
			- uri \http://localhost:9080/giper/web/bar/-/test.html
			icon \giper/web/logo/logo.svg
	body <= apps /
		<= Search $giper_web_bar_link
			title @ \Search
			uri \https://search.giper.dev/
			icon \giper/search/logo/logo.svg
		- <= Bot $giper_web_bar_link
			title @ \Bot
			uri \https://bot.giper.dev/#!prompt={query}
			icon \giper/bot/logo/logo.svg
		- <= Lingua $giper_web_bar_link
			title @ \Lingua
			uri \https://lingua.giper.dev/#!native_text={query}
			icon \giper/lingua/logo/logo.svg
		<= Player $giper_web_bar_link
			title @ \Player
			uri \https://player.giper.dev/#!search={query}
			icon \giper/player/logo/logo.svg
		<= Balls $giper_web_bar_link
			title @ \Balls
			uri \https://balls.giper.dev/
			icon \giper/balls/logo/logo.svg
		<= IQ $giper_web_bar_link
			title @ \IQ
			uri \https://iq.giper.dev/
			icon \giper/iq/logo/logo.svg
	foot /
		<= Sources $mol_link_source
			uri \https://github.com/giper-dev/web


$bog_dock_bar $giper_web_bar
	title @ \Bog Dock
	apps /
		<= Id $giper_web_bar_link
			title \ID
			uri \https://dev-cmyser.github.io/id/
			icon \bog/dock/logo/id.svg
		<= Gram $giper_web_bar_link
			title \Gram
			uri \https://b-on-g.github.io/gram/
			icon \bog/gram/logo/logo.svg
		<= Music $giper_web_bar_link
			title \Music
			uri \https://b-on-g.github.io/music/
			icon \bog/music/app/favicon.svg
		<= Todo $giper_web_bar_link
			title \Microtodo
			uri \https://b-on-g.github.io/microtodo/#!search={query}
			icon \bog/microtodo/assets/logo.svg
		<= Molefy $giper_web_bar_link
			title \Molefy
			uri \https://b-on-g.github.io/molefy/
			icon \bog/molefy/assets/logo.svg
		<= Merch $giper_web_bar_link
			title \Merchquarium
			uri \https://b-on-g.github.io/merchquarium/
			icon \bog/dock/logo/merch.svg
		<= Doodle $giper_web_bar_link
			title \Doodle
			uri \https://b-on-g.github.io/doodle/
			icon \bog/doodle/assets/logo.svg
		<= Atelier $giper_web_bar_link
			title \Atelier
			uri \https://b-on-g.github.io/atelier/
			icon \bog/atelier/assets/logo.svg
		<= Search
		<= Player
	head /
		<= Dock $giper_web_bar_link
			title <= title
			uri \https://b-on-g.github.io/dock/
			icon \bog/dock/logo/logo.svg
	foot /
		<= Giper $giper_web_bar_link
			title \Giper Web
			uri \https://web.giper.dev/
			icon \giper/web/logo/logo.svg
		<= Dock_sources $mol_link_source
			uri \https://github.com/b-on-g/dock

$mol_svg_circle $mol_svg
	dom_name \circle
	pos /
	attr *
		^
		r <= radius \.5%
		cx <= pos_x \
		cy <= pos_y \

$bog_dock_home_node $mol_link
	place /number
	main false
	dim false
	icon \
	target \_self
	hover? null
	leave? null
	event *
		^
		pointerenter? <=> hover?
		pointerleave? <=> leave?
		focusin? <=> hover?
		focusout? <=> leave?
	style *
		^
		left <= left \
		top <= top \
	attr *
		^
		bog_dock_home_node_main <= main
		bog_dock_home_node_dim <= dim
	sub /
		<= Icon $mol_image
			uri <= icon
		<= Title $mol_view
			sub /
				<= title \

$bog_dock_home $mol_view
	title @ \Bog Dock
	bar $bog_dock_bar
	focus? -1
	sub /
		<= Stage $mol_view
			sub <= stage /$mol_view
				<= Lines $mol_svg_root
					view_box \0 0 100 100
					sub <= lines /$mol_view
						<= Orbit $mol_svg_circle
							radius <= orbit \38
							pos /
								50
								50
				^ nodes /$mol_view
					<= Node*0 $bog_dock_home_node
						title <= node_title* \
						uri <= node_uri* \
						icon <= node_icon* \
						place <= node_place* /number
						main <= node_main* false
						dim <= node_dim* false
						hover? <=> node_hover*? null
						leave? <=> node_leave? null
		<= Caption $mol_view
			sub /
				<= caption @ \Hover an app to see its connections
	Line*0 $mol_svg_path
		geometry <= line_geometry* \
		attr *
			^
			bog_dock_home_kind <= line_kind* \
			bog_dock_home_dim <= line_dim* false
	label_login @ \Sign in with ID
	label_embed @ \Built in
	label_none @ \No connections yet

$bog_dock_app $mol_view
	plugins /
		<= Theme $mol_theme_auto
	title <= home_title
	sub /
		<= Bar $bog_dock_bar
		<= Home $bog_dock_home
			title => home_title
			bar <= Bar
